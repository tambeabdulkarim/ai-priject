# Phoenix Platform — shared/documented environment variables.
# Actual secrets are never committed (docs/10-SECURITY-BIBLE.md §17) — this
# file documents required keys with placeholder values only. Per-app
# variables live in each app's own .env.example (apps/web, apps/api,
# apps/workers, apps/admin).

# --- Shared infrastructure (docs/09-PLATFORM-ARCHITECTURE.md §7) ---
# Primary path: cloud-hosted (e.g. Neon serverless Postgres). Format:
# postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require
# Local-dev fallback (only on machines where Docker is usable): the
# infra/docker/docker-compose.yml Postgres service — postgresql://phoenix:phoenix@localhost:5432/phoenix
DATABASE_URL=

# Primary path: Upstash Redis REST API (used where a TCP connection isn't
# available/permitted, e.g. this managed device). No code currently
# depends on either form — see docs/09-PLATFORM-ARCHITECTURE.md §7.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local-dev fallback (Docker Compose Redis, TCP): REDIS_URL=redis://localhost:6379

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# --- Object storage (docs/09-PLATFORM-ARCHITECTURE.md §9) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Public site URL (used for canonical/OG metadata, sitemap, robots) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
