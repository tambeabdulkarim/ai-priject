// Phase 26 — Learning Paths & Project Evaluation Architecture. Not part of
// the original approved 49-table blueprint (docs/13-DATABASE-BLUEPRINT.md)
// — added post-blueprint to close two real gaps Phase 25 discovered and
// explicitly documented (docs/phase25-content-production-report.md's
// Database Findings #1-2), the same precedent as MfaRecoveryCode/MfaCrypto
// above (Phase 14.2), which also postdates the original blueprint and is
// documented with its own explanatory comments rather than a false
// docs/13-DATABASE-BLUEPRINT.md citation. See docs/16-API-CONTRACT.md
// §20-21 for the corresponding API contract.

/// A curated, ordered sequence of existing Courses (docs/content-library/
/// learning-paths.md's 9 named paths — 3 have real courses seeded as of
/// Phase 25/26). Deliberately NOT linked directly to Project — a path's
/// projects are simply the union of its member courses' own projects,
/// avoiding a redundant relation (see the Phase 26 report's "why not a
/// direct Project<->LearningPath relation" note).
model LearningPath {
  id          String                @id @default(uuid(7)) @db.Uuid
  title       String
  slug        String                @unique
  description String?
  /// draft | published | archived — same convention as Course.status
  status      String                @default("draft")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  courses     LearningPathCourse[]

  @@index([status])
  @@map("learning_paths")
  @@schema("courses")
}

/// Join table preserving per-path course ordering. `position` is the
/// path-relative order (independent of any other path the same course may
/// also belong to). The composite unique constraint is the actual
/// duplicate-membership guard this phase's "avoid duplicate course
/// membership within the same path" requirement calls for.
model LearningPathCourse {
  id             String       @id @default(uuid(7)) @db.Uuid
  learningPathId String       @map("learning_path_id") @db.Uuid
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  courseId       String       @map("course_id") @db.Uuid
  course         Course       @relation(fields: [courseId], references: [id])
  position       Int
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@unique([learningPathId, courseId])
  @@index([learningPathId, position])
  @@map("learning_path_courses")
  @@schema("courses")
}

/// A real, trackable educational project — the model Phase 25's
/// Lesson-based project briefs deliberately did NOT have (they still don't
/// need to: `sourceLessonId` links a Project to the Lesson that already
/// holds its full brief text in `Lesson.body`, so the brief is never
/// copied/duplicated — see docs/phase26-learning-path-project-architecture-
/// report.md's migration strategy for exactly which of the 6 Phase 25
/// briefs are linked this way). `instructions` is optional specifically
/// because lesson-sourced projects rely on the linked Lesson for their
/// brief; only a project created directly (no source lesson) needs its own
/// `instructions` text.
model Project {
  id             String              @id @default(uuid(7)) @db.Uuid
  courseId       String              @map("course_id") @db.Uuid
  course         Course              @relation(fields: [courseId], references: [id])
  sourceLessonId String?             @unique @map("source_lesson_id") @db.Uuid
  sourceLesson   Lesson?             @relation(fields: [sourceLessonId], references: [id])
  title          String
  description    String?
  instructions   String?
  /// draft | published | archived — same convention as Course.status
  status         String              @default("draft")
  position       Int                 @default(0)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  submissions    ProjectSubmission[]

  @@index([courseId, position])
  @@map("projects")
  @@schema("courses")
}

/// A learner's submitted work for a Project. `content` covers a text/URL
/// submission (e.g. a repo link or written reflection); `fileId` covers an
/// uploaded artifact via the existing File model (same pattern as
/// LessonFile.fileId). At least one of the two must be present — enforced
/// in ProjectsService, not the database, since Prisma has no portable
/// "at least one of" column constraint (same class of tradeoff already
/// accepted for Certificate.pdfFileId being nullable-with-service-level
/// rules). `attemptNumber` supports resubmission without losing history;
/// the unique constraint blocks only an accidental duplicate of the exact
/// same attempt, not a genuine resubmission (which increments the number).
model ProjectSubmission {
  id             String             @id @default(uuid(7)) @db.Uuid
  projectId      String             @map("project_id") @db.Uuid
  project        Project            @relation(fields: [projectId], references: [id])
  userId         String             @map("user_id") @db.Uuid
  user           User               @relation("ProjectSubmissionLearner", fields: [userId], references: [id])
  content        String?
  fileId         String?            @map("file_id") @db.Uuid
  file           File?              @relation(fields: [fileId], references: [id])
  attemptNumber  Int                @default(1) @map("attempt_number")
  /// submitted | evaluated — set to evaluated by ProjectsService when a
  /// ProjectEvaluation is created for this submission (same
  /// service-driven-state-transition pattern as CertificatesService
  /// issuing on Enrollment reaching 100%).
  status         String             @default("submitted")
  submittedAt    DateTime           @default(now()) @map("submitted_at") @db.Timestamptz
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  evaluation     ProjectEvaluation?

  @@unique([projectId, userId, attemptNumber])
  @@index([projectId])
  @@index([userId])
  @@map("project_submissions")
  @@schema("courses")
}

/// One evaluation per submission (1:1 — a resubmission gets a new
/// ProjectSubmission row with an incremented attemptNumber, and therefore
/// its own new evaluation, rather than overwriting history).
/// `method` is deliberately included now (not added later as a breaking
/// migration) so automated evaluation can be introduced in a future phase
/// without a schema change — Phase 26 itself only ever writes "manual",
/// per this phase's explicit instruction not to implement AI grading now.
model ProjectEvaluation {
  id           String            @id @default(uuid(7)) @db.Uuid
  submissionId String            @unique @map("submission_id") @db.Uuid
  submission   ProjectSubmission @relation(fields: [submissionId], references: [id])
  evaluatorId  String            @map("evaluator_id") @db.Uuid
  evaluator    User              @relation("ProjectEvaluationEvaluator", fields: [evaluatorId], references: [id])
  scorePercent Int               @map("score_percent")
  passed       Boolean
  feedback     String
  /// manual | automated — see model-level note. Always "manual" as written
  /// by Phase 26; the column exists so a future automated-evaluation
  /// feature is additive, not a breaking migration.
  method       String            @default("manual")
  /// completed | disputed — "disputed" is reserved for a future
  /// re-evaluation workflow; Phase 26 only ever writes "completed".
  status       String            @default("completed")
  evaluatedAt  DateTime          @default(now()) @map("evaluated_at") @db.Timestamptz
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@map("project_evaluations")
  @@schema("courses")
}

// LAYER 13 (cross-cutting, created any time after Users exists):
// Audit_Logs, Logs, Backups. Final layer — completes all 49 tables from
// docs/13-DATABASE-BLUEPRINT.md.

/// docs/13-DATABASE-BLUEPRINT.md — Audit_Logs (append-only; no update/delete
/// grant exists for this table at the application role level, per
/// docs/10-SECURITY-BIBLE.md §18 — enforced operationally, not by this
/// schema definition alone)
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([occurredAt])
  @@map("audit_logs")
  @@schema("auth")
}

/// docs/13-DATABASE-BLUEPRINT.md — Logs
model Log {
  id            String   @id @default(uuid(7)) @db.Uuid
  level         String
  sourceService String   @map("source_service")
  message       String
  context       Json?
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([occurredAt])
  @@index([sourceService])
  @@map("logs")
  @@schema("system")
}

/// docs/13-DATABASE-BLUEPRINT.md — Backups
model Backup {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// full | incremental | wal
  backupType         String    @map("backup_type")
  /// database | object-storage
  target             String
  storageLocation    String    @map("storage_location")
  takenAt            DateTime  @default(now()) @map("taken_at") @db.Timestamptz
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz
  /// pending | verified | failed
  verificationStatus String    @default("pending") @map("verification_status")

  @@index([takenAt])
  @@index([verificationStatus])
  @@map("backups")
  @@schema("system")
}
