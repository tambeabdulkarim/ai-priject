// Phoenix Platform — Prisma schema.
//
// Implements docs/13-DATABASE-BLUEPRINT.md and docs/14-DATABASE-RELATIONSHIPS.md
// incrementally, following the table creation order in
// docs/14-DATABASE-RELATIONSHIPS.md Part 5. Conventions per
// docs/11-DATABASE-BIBLE.md: snake_case table/column names (via @@map/@map),
// UUIDv7 primary keys, timestamptz timestamps, status/type columns kept as
// documented `text` (not native enums) per §4/§26 since these are expected
// to change occasionally. Postgres schema-per-domain per §3: auth, courses,
// library, marketplace, ai, news, files, system.
//
// LAYER 1 (foundational, no dependencies): Users, Roles, Permissions,
// Categories, News_Categories, Authors, AI_Providers, Languages, Tags.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "courses", "library", "marketplace", "ai", "news", "files", "system"]
}

// ===================== auth =====================

/// docs/13-DATABASE-BLUEPRINT.md — Users
/// avatar_file_id intentionally has no FK constraint yet: Files (files
/// schema) is created in Layer 2. The constraint is added once Files
/// exists, per docs/14-DATABASE-RELATIONSHIPS.md Part 6 (additive,
/// phase-by-phase migrations).
model User {
  id                     String            @id @default(uuid(7)) @db.Uuid
  email                  String            @unique
  emailVerifiedAt        DateTime?         @map("email_verified_at") @db.Timestamptz
  passwordHash           String?           @map("password_hash")
  displayName            String            @map("display_name")
  avatarFileId           String?           @map("avatar_file_id") @db.Uuid
  avatarFile             File?             @relation("UserAvatarFile", fields: [avatarFileId], references: [id])
  locale                 String            @default("ar")
  timezone               String            @default("UTC")
  /// active | suspended | deactivated
  status                 String            @default("active")
  // Marks accounts created by test/verification flows (not seeded product
  // reference data — Roles/Permissions/etc. are a separate concept). Every
  // row a test user touches (File.uploadedById, AuditLog.actorUserId, and
  // transitively Media via File) is identifiable by joining back to this
  // flag rather than duplicating it across tables. Intentionally not
  // exposed in any API response/DTO.
  isTestData             Boolean           @default(false) @map("is_test_data")
  // docs/10-SECURITY-BIBLE.md §5 (MFA Policy) — Phase 14.2. mfaSecret is
  // the TOTP shared secret, ENCRYPTED at rest (AES-256-GCM, see
  // common/services/mfa-crypto.service.ts) — never plaintext, and never a
  // one-way hash (unlike passwordHash), because verifying a TOTP code
  // requires the raw secret back. mfaSecret is set as soon as enrollment
  // begins (before confirmation) so the confirm step has something to
  // verify against; mfaEnabled only flips to true once a real code is
  // confirmed. Neither field is ever exposed via any API response — see
  // UsersService.toSafeUser.
  mfaEnabled             Boolean           @default(false) @map("mfa_enabled")
  mfaSecret              String?           @map("mfa_secret")
  deletedAt              DateTime?         @map("deleted_at") @db.Timestamptz
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  authors                Author[]
  uploadedFiles          File[]            @relation("FileUploadedBy")
  rolePermissionsGranted RolePermission[]
  sessions               UserSession[]
  settingsUpdated        Setting[]
  refreshTokens          RefreshToken[]
  mfaRecoveryCodes       MfaRecoveryCode[]
  notifications          Notification[]
  uploads                Upload[]
  versionsReplacedByMe   Version[]         @relation("VersionReplacedBy")
  coursesTaught          Course[]
  productsOwned          Product[]
  newsAuthored           News[]
  aiRequests             AiRequest[]
  comments               Comment[]
  enrollments            Enrollment[]
  orders                 Order[]
  downloads              Download[]
  bookmarks              Bookmark[]
  aiUsage                AiUsage[]
  quizAttempts           QuizAttempt[]
  readingProgress        ReadingProgress[]
  certificates           Certificate[]
  projectSubmissions     ProjectSubmission[]  @relation("ProjectSubmissionLearner")
  projectEvaluationsDone ProjectEvaluation[]  @relation("ProjectEvaluationEvaluator")
  auditLogs              AuditLog[]
  roleAssignments        UserRole[]        @relation("UserRoleAssignments")
  roleGrantsIssued       UserRole[]        @relation("UserRoleGrantedBy")

  @@index([status])
  @@map("users")
  @@schema("auth")
}

/// docs/13-DATABASE-BLUEPRINT.md — Roles
model Role {
  id              String           @id @default(uuid(7)) @db.Uuid
  name            String           @unique
  description     String?
  isSystemRole    Boolean          @default(false) @map("is_system_role")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
  @@schema("auth")
}

/// docs/13-DATABASE-BLUEPRINT.md — Permissions
model Permission {
  id              String           @id @default(uuid(7)) @db.Uuid
  key             String           @unique
  description     String?
  domain          String
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("auth")
}

/// docs/13-DATABASE-BLUEPRINT.md — Categories (shared taxonomy: courses,
/// library, marketplace — not news, which has its own News_Categories)
model Category {
  id               String        @id @default(uuid(7)) @db.Uuid
  parentCategoryId String?       @map("parent_category_id") @db.Uuid
  parent           Category?     @relation("CategoryToParent", fields: [parentCategoryId], references: [id])
  children         Category[]    @relation("CategoryToParent")
  name             String
  slug             String        @unique
  /// courses | library | marketplace — admin UI grouping only, not an access restriction
  domain           String
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  courses          Course[]
  libraryItems     LibraryItem[]
  products         Product[]

  @@index([parentCategoryId])
  @@map("categories")
  @@schema("library")
}

/// docs/13-DATABASE-BLUEPRINT.md — News_Categories
model NewsCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  news      News[]

  @@map("news_categories")
  @@schema("news")
}

/// docs/13-DATABASE-BLUEPRINT.md — Authors
/// avatar_file_id: same forward-reference note as User.avatarFileId above.
model Author {
  id           String        @id @default(uuid(7)) @db.Uuid
  linkedUserId String?       @map("linked_user_id") @db.Uuid
  linkedUser   User?         @relation(fields: [linkedUserId], references: [id])
  name         String
  bio          String?
  avatarFileId String?       @map("avatar_file_id") @db.Uuid
  avatarFile   File?         @relation("AuthorAvatarFile", fields: [avatarFileId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  libraryItems LibraryItem[]

  @@index([linkedUserId])
  @@map("authors")
  @@schema("library")
}

/// docs/13-DATABASE-BLUEPRINT.md — AI_Providers
model AiProvider {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String
  /// active | degraded | disabled
  status    String    @default("active")
  priority  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  aiModels  AiModel[]

  @@index([status])
  @@map("ai_providers")
  @@schema("ai")
}

/// docs/13-DATABASE-BLUEPRINT.md — Languages
model Language {
  id           String        @id @default(uuid(7)) @db.Uuid
  code         String        @unique
  name         String
  /// rtl | ltr
  direction    String
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  translations Translation[]

  @@map("languages")
  @@schema("system")
}

/// docs/13-DATABASE-BLUEPRINT.md — Tags
model Tag {
  id              String              @id @default(uuid(7)) @db.Uuid
  name            String              @unique
  slug            String              @unique
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  newsAssignments NewsTagAssignment[]

  @@map("tags")
  @@schema("news")
}

// LAYER 2 (first-level dependents): Role_Permissions, User_Sessions, Files,
// AI_Models, Translations, Settings. Also wires the FK constraint for
// User.avatarFileId / Author.avatarFileId → Files, deferred from Layer 1
// since Files did not exist yet.

/// docs/13-DATABASE-BLUEPRINT.md — Role_Permissions (pure join table, composite PK)
model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])
  grantedAt    DateTime   @default(now()) @map("granted_at") @db.Timestamptz
  grantedById  String?    @map("granted_by_id") @db.Uuid
  grantedBy    User?      @relation(fields: [grantedById], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("auth")
}

/// docs/13-DATABASE-BLUEPRINT.md — User_Roles (pure join table, composite PK)
/// Added during the Database Documentation Consistency Audit / Phase 3
/// implementation — Users and Roles always documented this relationship
/// in prose but no formal table existed. Mirrors Role_Permissions exactly.
model UserRole {
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation("UserRoleAssignments", fields: [userId], references: [id])
  roleId      String   @map("role_id") @db.Uuid
  role        Role     @relation(fields: [roleId], references: [id])
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz
  grantedById String?  @map("granted_by_id") @db.Uuid
  grantedBy   User?    @relation("UserRoleGrantedBy", fields: [grantedById], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
  @@schema("auth")
}

/// docs/13-DATABASE-BLUEPRINT.md — User_Sessions
model UserSession {
  id            String         @id @default(uuid(7)) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  user          User           @relation(fields: [userId], references: [id])
  deviceLabel   String?        @map("device_label")
  userAgent     String?        @map("user_agent")
  ipAddress     String?        @map("ip_address")
  lastActiveAt  DateTime?      @map("last_active_at") @db.Timestamptz
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
  @@schema("auth")
}

/// docs/13-DATABASE-BLUEPRINT.md — Files (shared infrastructure, files schema)
model File {
  id               String    @id @default(uuid(7)) @db.Uuid
  uploadedById     String    @map("uploaded_by_id") @db.Uuid
  uploadedBy       User      @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  storageKey       String    @unique @map("storage_key")
  originalFilename String    @map("original_filename")
  mimeType         String    @map("mime_type")
  sizeBytes        BigInt    @map("size_bytes")
  /// pending | clean | quarantined
  scanStatus       String    @default("pending") @map("scan_status")
  /// private | public
  visibility       String    @default("private")
  // Phase 13.3: soft delete, same convention already used by User.deletedAt
  // — DELETE /files/:id sets this rather than removing the row, so
  // existing relations (LessonFile, Product, LibraryItem, Certificate,
  // avatars) are left untouched (cascading a hard delete through all of
  // those is real, separate, out-of-scope risk).
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  usersWithAvatar    User[]        @relation("UserAvatarFile")
  authorsWithAvatar  Author[]      @relation("AuthorAvatarFile")
  upload             Upload?
  media              Media?
  versionsAsCurrent  Version[]     @relation("VersionCurrentFile")
  versionsAsPrevious Version[]     @relation("VersionPreviousFile")
  libraryItems       LibraryItem[]
  products           Product[]
  lessonFiles        LessonFile[]
  certificates       Certificate[]
  projectSubmissions ProjectSubmission[]

  @@index([uploadedById])
  @@index([scanStatus])
  @@map("files")
  @@schema("files")
}

/// docs/13-DATABASE-BLUEPRINT.md — AI_Models
model AiModel {
  id                    String      @id @default(uuid(7)) @db.Uuid
  providerId            String      @map("provider_id") @db.Uuid
  provider              AiProvider  @relation(fields: [providerId], references: [id])
  modelIdentifier       String      @map("model_identifier")
  /// chat | completion | embedding
  capability            String
  costPer1kInputTokens  Decimal     @map("cost_per_1k_input_tokens") @db.Decimal(10, 6)
  costPer1kOutputTokens Decimal     @map("cost_per_1k_output_tokens") @db.Decimal(10, 6)
  isDefault             Boolean     @default(false) @map("is_default")
  deprecatedAt          DateTime?   @map("deprecated_at") @db.Timestamptz
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  aiRequests            AiRequest[]

  @@index([providerId])
  @@map("ai_models")
  @@schema("ai")
}

/// docs/13-DATABASE-BLUEPRINT.md — Translations
model Translation {
  id         String   @id @default(uuid(7)) @db.Uuid
  languageId String   @map("language_id") @db.Uuid
  language   Language @relation(fields: [languageId], references: [id])
  key        String
  value      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([languageId, key])
  @@map("translations")
  @@schema("system")
}

/// docs/13-DATABASE-BLUEPRINT.md — Settings
model Setting {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  value       String
  description String?
  isSensitive Boolean  @default(false) @map("is_sensitive")
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
  @@schema("system")
}

// LAYER 3 (second-level dependents): Refresh_Tokens, Notifications, Uploads,
// Media, Versions, Prompt_Templates.

/// docs/13-DATABASE-BLUEPRINT.md — Refresh_Tokens
model RefreshToken {
  id              String         @id @default(uuid(7)) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  user            User           @relation(fields: [userId], references: [id])
  sessionId       String         @map("session_id") @db.Uuid
  session         UserSession    @relation(fields: [sessionId], references: [id])
  tokenHash       String         @unique @map("token_hash")
  previousTokenId String?        @map("previous_token_id") @db.Uuid
  previousToken   RefreshToken?  @relation("RefreshTokenChain", fields: [previousTokenId], references: [id])
  nextTokens      RefreshToken[] @relation("RefreshTokenChain")
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz
  usedAt          DateTime?      @map("used_at") @db.Timestamptz
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz
  revokedReason   String?        @map("revoked_reason")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("auth")
}

/// docs/10-SECURITY-BIBLE.md §5 — MFA recovery codes (Phase 14.2). Not in
/// docs/13-DATABASE-BLUEPRINT.md (predates this work). Modeled exactly
/// like RefreshToken above: individually hashed rows (never a JSON array
/// on User), single-use (usedAt), auditable, indexed by owner —
/// high-entropy generated codes, not user-chosen, so a fast deterministic
/// hash (SHA-256, same reasoning as RefreshToken.tokenHash) is correct,
/// not Argon2id.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("mfa_recovery_codes")
  @@schema("auth")
}

/// docs/13-DATABASE-BLUEPRINT.md — Notifications
/// source_event_id intentionally has no FK, per doc: "not a hard foreign
/// key, to avoid coupling this table to every other domain."
model Notification {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id])
  type          String
  title         String
  body          String?
  linkUrl       String?   @map("link_url")
  readAt        DateTime? @map("read_at") @db.Timestamptz
  /// in_app | email | push
  channel       String
  sourceEventId String?   @map("source_event_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
  @@schema("auth")
}

/// docs/13-DATABASE-BLUEPRINT.md — Uploads
model Upload {
  id                   String   @id @default(uuid(7)) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  user                 User     @relation(fields: [userId], references: [id])
  fileId               String?  @unique @map("file_id") @db.Uuid
  file                 File?    @relation(fields: [fileId], references: [id])
  presignedUrlIssuedAt DateTime @default(now()) @map("presigned_url_issued_at") @db.Timestamptz
  expectedSizeBytes    BigInt   @map("expected_size_bytes")
  /// pending | completed | expired | failed
  status               String   @default("pending")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@index([status])
  @@map("uploads")
  @@schema("files")
}

/// docs/13-DATABASE-BLUEPRINT.md — Media
model Media {
  id                String   @id @default(uuid(7)) @db.Uuid
  fileId            String   @unique @map("file_id") @db.Uuid
  file              File     @relation(fields: [fileId], references: [id])
  /// video | image | audio
  mediaType         String   @map("media_type")
  durationSeconds   Int?     @map("duration_seconds")
  /// pending | processing | ready | failed
  transcodingStatus String   @default("pending") @map("transcoding_status")
  hlsManifestKey    String?  @map("hls_manifest_key")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz
  lessons           Lesson[]

  @@index([transcodingStatus])
  @@index([mediaType])
  @@map("media")
  @@schema("files")
}

/// docs/13-DATABASE-BLUEPRINT.md — Versions
model Version {
  id             String   @id @default(uuid(7)) @db.Uuid
  fileId         String   @map("file_id") @db.Uuid
  file           File     @relation("VersionCurrentFile", fields: [fileId], references: [id])
  previousFileId String   @map("previous_file_id") @db.Uuid
  previousFile   File     @relation("VersionPreviousFile", fields: [previousFileId], references: [id])
  versionNumber  Int      @map("version_number")
  replacedAt     DateTime @default(now()) @map("replaced_at") @db.Timestamptz
  replacedById   String   @map("replaced_by_id") @db.Uuid
  replacedBy     User     @relation("VersionReplacedBy", fields: [replacedById], references: [id])
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([fileId])
  @@map("versions")
  @@schema("files")
}

/// docs/13-DATABASE-BLUEPRINT.md — Prompt_Templates
model PromptTemplate {
  id                 String      @id @default(uuid(7)) @db.Uuid
  name               String
  version            String
  systemInstructions String      @map("system_instructions")
  userInputSchema    String      @map("user_input_schema")
  isActive           Boolean     @default(true) @map("is_active")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  aiRequests         AiRequest[]

  @@unique([name, version])
  @@map("prompt_templates")
  @@schema("ai")
}

// LAYER 4 (content root tables): Courses, Library_Items, Products, News,
// AI_Requests.

/// docs/13-DATABASE-BLUEPRINT.md — Courses
model Course {
  id           String        @id @default(uuid(7)) @db.Uuid
  instructorId String        @map("instructor_id") @db.Uuid
  instructor   User          @relation(fields: [instructorId], references: [id])
  categoryId   String        @map("category_id") @db.Uuid
  category     Category      @relation(fields: [categoryId], references: [id])
  title        String
  slug         String        @unique
  description  String?
  /// draft | in_review | published | archived
  status       String        @default("draft")
  priceCents   Int           @default(0) @map("price_cents")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  modules      Module[]
  enrollments  Enrollment[]
  certificates Certificate[]
  learningPaths LearningPathCourse[]
  projects     Project[]

  @@index([status])
  @@index([instructorId])
  // Phase 16 — docs/phase15-production-readiness-report.md's High-severity
  // finding: categoryId is filtered on in courses.repository.ts but had no
  // supporting index, unlike LibraryItem.categoryId just above, which does.
  @@index([categoryId])
  @@map("courses")
  @@schema("courses")
}

/// docs/13-DATABASE-BLUEPRINT.md — Library_Items
model LibraryItem {
  id              String            @id @default(uuid(7)) @db.Uuid
  authorId        String            @map("author_id") @db.Uuid
  author          Author            @relation(fields: [authorId], references: [id])
  categoryId      String            @map("category_id") @db.Uuid
  category        Category          @relation(fields: [categoryId], references: [id])
  fileId          String            @map("file_id") @db.Uuid
  file            File              @relation(fields: [fileId], references: [id])
  title           String
  slug            String            @unique
  description     String?
  /// draft | published
  status          String            @default("draft")
  priceCents      Int?              @map("price_cents")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  downloads       Download[]
  bookmarks       Bookmark[]
  readingProgress ReadingProgress[]

  @@index([status])
  @@index([categoryId])
  @@map("library_items")
  @@schema("library")
}

/// docs/13-DATABASE-BLUEPRINT.md — Products
model Product {
  id          String      @id @default(uuid(7)) @db.Uuid
  categoryId  String      @map("category_id") @db.Uuid
  category    Category    @relation(fields: [categoryId], references: [id])
  ownerId     String?     @map("owner_id") @db.Uuid
  owner       User?       @relation(fields: [ownerId], references: [id])
  fileId      String?     @map("file_id") @db.Uuid
  file        File?       @relation(fields: [fileId], references: [id])
  title       String
  slug        String      @unique
  description String?
  priceCents  Int         @default(0) @map("price_cents")
  /// draft | published | archived
  status      String      @default("draft")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  orderItems  OrderItem[]

  @@index([status])
  // Phase 16 — same categoryId gap as Course above, same reasoning.
  @@index([categoryId])
  @@map("products")
  @@schema("marketplace")
}

/// docs/13-DATABASE-BLUEPRINT.md — News
model News {
  id             String              @id @default(uuid(7)) @db.Uuid
  authorId       String              @map("author_id") @db.Uuid
  author         User                @relation(fields: [authorId], references: [id])
  categoryId     String              @map("category_id") @db.Uuid
  category       NewsCategory        @relation(fields: [categoryId], references: [id])
  title          String
  slug           String              @unique
  body           String
  /// draft | in_review | published
  status         String              @default("draft")
  publishedAt    DateTime?           @map("published_at") @db.Timestamptz
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  tagAssignments NewsTagAssignment[]
  comments       Comment[]

  @@index([status])
  @@index([publishedAt])
  @@map("news")
  @@schema("news")
}

/// docs/13-DATABASE-BLUEPRINT.md — AI_Requests
model AiRequest {
  id               String          @id @default(uuid(7)) @db.Uuid
  userId           String?         @map("user_id") @db.Uuid
  user             User?           @relation(fields: [userId], references: [id])
  modelId          String          @map("model_id") @db.Uuid
  model            AiModel         @relation(fields: [modelId], references: [id])
  promptTemplateId String?         @map("prompt_template_id") @db.Uuid
  promptTemplate   PromptTemplate? @relation(fields: [promptTemplateId], references: [id])
  feature          String
  /// success | error | moderation_blocked
  status           String
  inputTokens      Int?            @map("input_tokens")
  outputTokens     Int?            @map("output_tokens")
  latencyMs        Int?            @map("latency_ms")
  promptRedacted   String?         @map("prompt_redacted")
  responseRedacted String?         @map("response_redacted")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  cost             AiCost?

  @@index([userId])
  @@index([feature])
  @@index([createdAt])
  @@map("ai_requests")
  @@schema("ai")
}

// LAYER 5 (content structure tables): Modules, News_Tag_Assignments.

/// docs/13-DATABASE-BLUEPRINT.md — Modules
model Module {
  id          String   @id @default(uuid(7)) @db.Uuid
