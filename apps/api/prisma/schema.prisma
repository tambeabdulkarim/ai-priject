/// docs/13-DATABASE-BLUEPRINT.md — Tags (News_Tag_Assignments join table,
/// resolves the News ↔ Tags many-to-many per docs/14-DATABASE-RELATIONSHIPS.md)
model NewsTagAssignment {
  newsId    String   @map("news_id") @db.Uuid
  news      News     @relation(fields: [newsId], references: [id])
  tagId     String   @map("tag_id") @db.Uuid
  tag       Tag      @relation(fields: [tagId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([newsId, tagId])
  @@index([tagId])
  @@map("news_tag_assignments")
  @@schema("news")
}

// LAYER 6 (content leaf tables): Lessons, Comments.

/// docs/13-DATABASE-BLUEPRINT.md — Lessons
model Lesson {
  id              String           @id @default(uuid(7)) @db.Uuid
  moduleId        String           @map("module_id") @db.Uuid
  module          Module           @relation(fields: [moduleId], references: [id])
  title           String
  position        Int
  /// video | text | quiz
  contentType     String           @map("content_type")
  body            String?
  videoMediaId    String?          @map("video_media_id") @db.Uuid
  videoMedia      Media?           @relation(fields: [videoMediaId], references: [id])
  durationSeconds Int?             @map("duration_seconds")
  isPreview       Boolean          @default(false) @map("is_preview")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  lessonFiles     LessonFile[]
  quizzes         Quiz[]
  progress        LessonProgress[]
  /// Phase 26 — reverse of Project.sourceLessonId, optional 1:1 (not every
  /// lesson has a linked Project, and this relation never implies the
  /// lesson's body content is duplicated onto the Project — see Project's
  /// own doc comment).
  project         Project?

  @@index([moduleId, position])
  @@map("lessons")
  @@schema("courses")
}

/// docs/13-DATABASE-BLUEPRINT.md — Comments
model Comment {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id])
  newsId          String    @map("news_id") @db.Uuid
  news            News      @relation(fields: [newsId], references: [id])
  parentCommentId String?   @map("parent_comment_id") @db.Uuid
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentReplies")
  body            String
  /// visible | hidden | flagged
  status          String    @default("visible")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([newsId])
  @@index([parentCommentId])
  @@index([userId])
  @@map("comments")
  @@schema("news")
}

