// LAYER 9 (transactional/engagement tables): Enrollments, Orders,
// Downloads, Bookmarks, Coupons, AI_Usage, AI_Costs.

/// docs/13-DATABASE-BLUEPRINT.md — Enrollments
/// KNOWN DOC INCONSISTENCY: docs/13-DATABASE-BLUEPRINT.md lists a foreign
/// key "purchase_id → Purchases.id", but no `Purchases` table exists
/// anywhere in the approved 49-table blueprint (docs/13, docs/14) — the
/// marketplace domain uses Payments/Order_Items instead. Implemented here
/// as a plain, unconstrained nullable UUID column (no FK) rather than
/// inventing an undocumented table or guessing which real table it should
/// reference. Flagged for clarification before Phase 4 (Backend API).
model Enrollment {
  id                String           @id @default(uuid(7)) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  user              User             @relation(fields: [userId], references: [id])
  courseId          String           @map("course_id") @db.Uuid
  course            Course           @relation(fields: [courseId], references: [id])
  /// docs/13-DATABASE-BLUEPRINT.md — corrected during the Database
  /// Documentation Consistency Audit: previously an unconstrained column
  /// intended for a non-existent "Purchases" table. Now correctly
  /// references Order_Items (entitlement is granted per purchased line
  /// item, not per order/payment). Nullable — free courses have no purchase.
  orderItemId       String?          @map("order_item_id") @db.Uuid
  orderItem         OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  enrolledAt        DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz
  completedAt       DateTime?        @map("completed_at") @db.Timestamptz
  completionPercent Int              @default(0) @map("completion_percent")
  /// active | expired | refunded
  status            String           @default("active")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  lessonProgress    LessonProgress[]
  certificate       Certificate?

  @@unique([userId, courseId])
  @@index([status])
  @@map("enrollments")
  @@schema("courses")
}

/// docs/13-DATABASE-BLUEPRINT.md — Orders
model Order {
  id          String      @id @default(uuid(7)) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  user        User        @relation(fields: [userId], references: [id])
  couponId    String?     @map("coupon_id") @db.Uuid
  coupon      Coupon?     @relation(fields: [couponId], references: [id])
  orderNumber String      @unique @map("order_number")
  /// pending | paid | refunded | cancelled
  status      String      @default("pending")
  totalCents  Int         @map("total_cents")
  currency    String      @default("USD")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  orderItems  OrderItem[]
  payments    Payment[]

  @@index([userId])
  @@index([status])
  // Phase 16 — docs/phase15-production-readiness-report.md's Medium-
  // severity finding: orders.repository.ts's admin listing filters by a
  // createdAt date range and sorts by createdAt desc, with no supporting
  // index.
  @@index([createdAt])
  @@map("orders")
  @@schema("marketplace")
}

/// docs/13-DATABASE-BLUEPRINT.md — Downloads
model Download {
