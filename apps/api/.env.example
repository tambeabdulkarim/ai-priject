# apps/api — backend service (docs/09-PLATFORM-ARCHITECTURE.md §6).

PORT=4000

# Primary path: cloud-hosted Postgres (e.g. Neon). Format:
# postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require
# Local-dev fallback: infra/docker/docker-compose.yml — postgresql://phoenix:phoenix@localhost:5432/phoenix
DATABASE_URL=

# Primary path: Upstash Redis REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local-dev fallback (Docker Compose Redis, TCP): REDIS_URL=redis://localhost:6379

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# --- Auth (docs/10-SECURITY-BIBLE.md §7) ---
# RS256 key pair (PEM). Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL=15m
JWT_ISSUER=phoenix-platform

# docs/10-SECURITY-BIBLE.md §4 — per-install password pepper (secrets manager).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PASSWORD_PEPPER=

# --- Object storage (docs/09-PLATFORM-ARCHITECTURE.md §9) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Payments (docs/16-API-CONTRACT.md §12) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI Gateway (docs/12-AI-INTEGRATION-BIBLE.md §3) ---
AI_PROVIDER_OPENAI_API_KEY=
AI_PROVIDER_ANTHROPIC_API_KEY=
