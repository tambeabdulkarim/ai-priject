# apps/api — backend service (docs/09-PLATFORM-ARCHITECTURE.md §6).

PORT=4000

# Primary path: cloud-hosted Postgres (e.g. Neon). Format:
# postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require
# Local-dev fallback: infra/docker/docker-compose.yml — postgresql://phoenix:phoenix@localhost:5432/phoenix
DATABASE_URL=

# Primary path: Upstash Redis REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local-dev fallback (Docker Compose Redis, TCP): REDIS_URL=redis://localhost:6379

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# --- Auth (docs/10-SECURITY-BIBLE.md §7) ---
# RS256 key pair (PEM). Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL=15m
JWT_ISSUER=phoenix-platform

# docs/10-SECURITY-BIBLE.md §4 — per-install password pepper (secrets manager).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PASSWORD_PEPPER=

# docs/10-SECURITY-BIBLE.md §5 — per-install MFA TOTP-secret encryption key
# (AES-256-GCM, 32 raw bytes, base64). Same generation command as above.
# Rotating this key invalidates every enrolled user's stored TOTP secret
# (they would need to re-enroll) — treat it like PASSWORD_PEPPER, not like
# a rotatable JWT signing key.
MFA_ENCRYPTION_KEY=

# --- Object storage (docs/09-PLATFORM-ARCHITECTURE.md §9) ---
# Primary path: Backblaze B2 (S3-compatible API), used because local Docker
# (MinIO) cannot run in this environment — blocked by IT/device policy,
# classified Infrastructure Pending, not an application bug. Any other
# S3-compatible provider (Cloudflare R2, AWS S3, DigitalOcean Spaces, MinIO)
# works identically — StorageService only depends on STORAGE_ENDPOINT.
#   STORAGE_ENDPOINT=https://s3.<region>.backblazeb2.com
#   STORAGE_BUCKET=<your-bucket-name>
#   STORAGE_ACCESS_KEY_ID=<B2 application key ID>
#   STORAGE_SECRET_ACCESS_KEY=<B2 application key>
#   STORAGE_REGION=<region, e.g. us-east-005>
#
# Path-style addressing (required by B2 and MinIO; not needed by AWS S3):
# already forced unconditionally in code (`forcePathStyle: true` in
# apps/api/src/storage/storage.service.ts), so there is no
# STORAGE_FORCE_PATH_STYLE env var to set here — it would be dead
# configuration since nothing reads it.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=

# --- Payments (docs/16-API-CONTRACT.md §12) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI Gateway (docs/12-AI-INTEGRATION-BIBLE.md §3) ---
AI_PROVIDER_OPENAI_API_KEY=
AI_PROVIDER_ANTHROPIC_API_KEY=

# --- Email (Phase 16 — docs/phase16-production-validation-report.md) ---
# Postmark (docs/09-PLATFORM-ARCHITECTURE.md §11 named SES/Postmark as the
# two candidates; Postmark chosen — no AWS account exists elsewhere in
# this project, and it's purpose-built for transactional mail, which is
# this platform's real need: verification, password reset, MFA
# notifications). Get a server token from your Postmark account's
# "API Tokens" tab. Both values below must be set for real delivery —
# leaving either blank makes EmailService log instead of send (safe for
# local dev, not safe for production; see apps/api/src/common/services/
# email.service.ts).
POSTMARK_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Phoenix Project
