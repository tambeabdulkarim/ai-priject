{
  "extends": "../../packages/config/base.tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
